        "from tensorflow.keras.models import load_model\n",
        "from tensorflow.keras.preprocessing.image import ImageDataGenerator\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import random\n",
        "from tensorflow.keras.applications.mobilenet_v2 import preprocess_input\n",
        "\n",
        "# Load the saved model\n",
        "model = load_model(\"model_mobile.h5\")\n",
        "\n",
        "# Define test data generator\n",
        "test_datagen = ImageDataGenerator(preprocessing_function=preprocess_input)  # MobileNetV2 preprocessing\n",
        "\n",
        "test_generator = test_datagen.flow_from_directory(\n",
        "    \"./dataset/test\",  # Replace with actual test set path\n",
        "    target_size=(224, 224),  # MobileNetV2 input size\n",
        "    batch_size=1,\n",
        "    class_mode=\"categorical\",\n",
        "    shuffle=False\n",
        ")\n",
        "\n",
        "# Get class labels\n",
        "class_labels = list(test_generator.class_indices.keys())\n",
        "\n",
        "# Load test images and labels\n",
        "X_test, y_test = [], []\n",
        "num_classes = len(class_labels)\n",
        "samples_per_class = 10  # Number of images per class\n",
        "\n",
        "# Collect 10 images from each class\n",
        "for class_idx in range(num_classes):\n",
        "    class_images = []\n",
        "    for i in range(len(test_generator.filenames)):\n",
        "        if test_generator.classes[i] == class_idx:\n",
        "            img, label = test_generator[i]\n",
        "            class_images.append((img[0], label[0]))  # Store image and label\n",
        "            if len(class_images) >= samples_per_class:\n",
        "                break\n",
        "    X_test.extend(class_images)\n",
        "\n",
        "# Shuffle collected images\n",
        "random.shuffle(X_test)\n",
        "\n",
        "# Extract images and labels\n",
        "images, true_labels = zip(*X_test)\n",
        "images = np.array(images)\n",
        "true_labels = np.argmax(np.array(true_labels), axis=1)  # Convert one-hot to class index"
      ]
    },
