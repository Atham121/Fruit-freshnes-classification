        "import os\n",
        "import shutil\n",
        "import random\n",
        "\n",
        "# ✅ Define source and destination paths\n",
        "raw_train_dir = \"./dataset/train\"\n",
        "raw_test_dir = \"./dataset/test\"\n",
        "balanced_train_dir = \"./dataset/balanced/train\"\n",
        "balanced_test_dir = \"./dataset/balanced/test\"\n",
        "\n",
        "# ✅ Ensure balanced dataset directories exist\n",
        "for folder in [balanced_train_dir, balanced_test_dir]:\n",
        "    os.makedirs(folder, exist_ok=True)\n",
        "\n",
        "# ✅ Function to balance dataset from separate train & test sets\n",
        "def balance_dataset(train_src, test_src, train_dest, test_dest, train_size=1400, test_size=380):\n",
        "    for class_name in os.listdir(train_src):  # Iterate through each class\n",
        "        train_class_path = os.path.join(train_src, class_name)\n",
        "        test_class_path = os.path.join(test_src, class_name)\n",
        "\n",
        "        # Ensure class exists in both train & test folders\n",
        "        if not os.path.exists(test_class_path):\n",
        "            print(f\" Warning: Test folder missing for class {class_name}, skipping...\")\n",
        "            continue\n",
        "\n",
        "        # Get all images in the class\n",
        "        train_images = os.listdir(train_class_path)\n",
        "        test_images = os.listdir(test_class_path)\n",
        "\n",
        "        # Ensure enough images exist for both train & test\n",
        "        if len(train_images) < train_size:\n",
        "            print(f\" Warning: Not enough train images in {class_name} (Found: {len(train_images)}, Needed: {train_size})\")\n",
        "            continue\n",
        "\n",
        "        if len(test_images) < test_size:\n",
        "            print(f\" Warning: Not enough test images in {class_name} (Found: {len(test_images)}, Needed: {test_size})\")\n",
        "            continue\n",
        "\n",
        "        # Shuffle and select images\n",
        "        random.shuffle(train_images)\n",
        "        random.shuffle(test_images)\n",
        "        selected_train = train_images[:train_size]  # Take 1400 for training\n",
        "        selected_test = test_images[:test_size]  # Take 380 for testing\n",
        "\n",
        "        # Create class directories in balanced dataset\n",
        "        os.makedirs(os.path.join(train_dest, class_name), exist_ok=True)\n",
        "        os.makedirs(os.path.join(test_dest, class_name), exist_ok=True)\n",
        "\n",
        "        # Copy selected images to the new balanced dataset\n",
        "        for img in selected_train:\n",
        "            shutil.copy(os.path.join(train_class_path, img), os.path.join(train_dest, class_name, img))\n",
        "\n",
        "        for img in selected_test:\n",
        "            shutil.copy(os.path.join(test_class_path, img), os.path.join(test_dest, class_name, img))\n",
        "\n",
        "        print(f\"✅ {class_name}: {train_size} train, {test_size} test images copied.\")\n",
        "\n",
        "# ✅ Run the balancing function\n",
        "balance_dataset(raw_train_dir, raw_test_dir, balanced_train_dir, balanced_test_dir)\n",
        "\n",
        "print(\"\\n Dataset successfully balanced with 1400 train & 380 test images per class!\")"
      ]
